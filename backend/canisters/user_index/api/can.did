type ActionSigningKeyStatus = variant { VerifyOnly; Staged; Active };
type ActionSigningPublicKey = record {
  status : ActionSigningKeyStatus;
  key_id : blob;
  verify_until : opt nat64;
  created_at : nat64;
  public_key_pem : text;
};
type AiActionCardRowTemplate = record {
  // Key in the model's JSON output to read this row's value from.
  field : text;
  // Human-readable label shown on the card row.
  label : text;
};
// Generic, app-agnostic template describing the confirmable card produced from the model's output.
type AiActionCardTemplate = record {
  title : text;
  rows : vec AiActionCardRowTemplate;
  confirm_label : text;
  disclosure : opt text;
  cancel_label : text;
};
// A single, generic "AI action": an app-supplied configuration that lets a client-side model propose a
// *confirmable, authenticated* in-chat action. Nothing here is specific to any one app — the prompt,
// output schema, card layout and delivery endpoint are all supplied by the app that declares the action,
// so the same mechanism serves any consumer.
type AiActionDefinition = record {
  // When true, this action can extract from an IMAGE message, so OpenChat's auto-propose chip
  // offers it on images. Absent (manifests predating the flag) === false — an app opts in.
  accepts_image : bool;
  // Where a confirmed action is delivered — the consumer's signed webhook endpoint.
  endpoint : text;
  // How to turn the model's output into a confirmable card shown to the user.
  card : AiActionCardTemplate;
  // Stable, human-readable identifier (e.g. "expense.import"), unique per owner.
  name : text;
  description : text;
  // Absent retains the legacy confirmer-only recipient scope.
  recipient_scope : opt AiActionRecipientScope;
  // Optional public key (PEM) the consumer advertises so the payload can be verified end-to-end.
  consumer_public_key : opt text;
  // Prompt the on-device model is run with; the client substitutes the user's input before inference.
  prompt_template : text;
  // JSON Schema the model's structured output must conform to.
  response_schema : text;
  // Optional extraction rules that steer the model's prompt and deterministically post-process its
  // output on the client. Absent means no rules.
  rules : vec AiActionRule;
};
type AiActionRecipientScope = variant { app_authorized; confirmer };
// A single, generic extraction rule. Rules are declared by whoever registers the action and are
// interpreted entirely on the client: some contribute guidance lines to the prompt, others run as a
// deterministic post-pass over the model's structured output.
type AiActionRule = variant {
  context : ContextRule;
  keyword_map : KeywordMapRule;
  from_message : FromMessageRule;
  normalize : NormalizeRule;
  instruction : InstructionRule;
};
type AiAppCardCapabilityScope = variant { private_context };
type AiAppLookup = record { app_id : nat32; revision : opt nat64 };
// The caller-supplied part of an AI app registration: one manifest covering the app's identity, its
// app-level delivery key and every action it offers. Registering the same `name` again (by the same
// owner) upserts the whole manifest, so an external app can keep itself up to date with a single call
// from a deploy script.
type AiAppManifest = record {
  // Optional per-app inbox canister: confirmed actions from this app are deposited here instead of
  // OpenChat's globally configured action_inbox (per-app isolation + cycles). App-declared routing,
  // carried onto each confirmed action card; OpenChat never interprets the deposited payload.
  inbox_canister_id : opt principal;
  // App-declared UI surfaces OpenChat can open on the app's behalf (e.g. a chat-linking page).
  // Absent on the wire means none.
  surfaces : vec AiAppSurface;
  // When set, each user's confirmed actions are delivered encrypted to that user's own registered
  // key (see `AiAppUserKey`) instead of the app-level `consumer_public_key`. A user with no key
  // registered yet must link the app first (via a one-time link code) before actions can run.
  per_user_keys : bool;
  // Stable, human-readable ASCII identifier. Case and visual separators share a canonical key.
  // Re-registering the caller's key upserts its stable id. Unpublished reservations are bounded
  // and expiring; only a canister-vouched, governance-published app owns the key exclusively.
  name : text;
  description : text;
  // The actions this app offers. A per-action `consumer_public_key`, when set, overrides the app key.
  actions : vec AiActionDefinition;
  // P-256 SPKI PEM: the app-level delivery key confirmed actions are encrypted/verified against.
  // May be empty when `per_user_keys` is set — delivery then always targets the acting user's own
  // registered key and this app-level key is never read.
  consumer_public_key : text;
  icon_url : opt text;
  // The app's own IC canister. When set, `publish_ai_app` calls its generic
  // `c2c_verify_ai_app_v2` method and publishes only when it vouches for the exact registry,
  // owner, canonical name, app id/revision and full manifest commitment. This is app-agnostic:
  // OpenChat knows only the well-known verifier contract. `serde(default)` preserves
  // upgrade/wire compatibility like the other optional fields.
  app_canister_id : opt principal;
};
// A registered AI app. The on-chain `id`, `owner` and timestamps are assigned by the canister.
type AiAppRegistration = record {
  id : nat32;
  created : nat64;
  owner : principal;
  // Directory visibility: a new registration starts UNPUBLISHED (visible only to its owner, so
  // it can be developed/tested privately); `publish_ai_app` flips it. `serde(default)` makes
  // pre-upgrade entries deserialize as unpublished. A sibling of `manifest` deliberately; a
  // changed manifest resets it and requires a fresh exact-revision verifier decision.
  published : bool;
  updated : nat64;
  manifest : AiAppManifest;
};
// A UI surface an app declares in its manifest: a URL OpenChat opens at well-known moments so the
// user can configure the app without leaving the chat client.
type AiAppSurface = record {
  // URL template. The only substituted placeholder is the public {appId}. App-scoped
  // subject/chat/message handles are delivered over authenticated card/link contracts, never
  // in navigation URLs.
  url : text;
  // What the surface is for. "chat_link" = configure/link a chat inside the app (opened by
  // OpenChat after the first confirmed action in a chat). Other kinds are app-defined; OpenChat
  // ignores kinds it does not know.
  kind : text;
  display : SurfaceDisplay;
};
// App-facing pseudonymous identity for one card. OpenChat's raw user, chat, thread, and message
// coordinates stay inside its authority chain; an external app receives only dedicated-key HMAC
// handles scoped to the exact UserIndex, app id, and registered app canister.
type AppScopedCardContext = record {
  context_version : nat16;
  action_id : text;
  message_handle : blob;
  app_revision : nat64;
  app_id : nat32;
  app_subject : blob;
  chat_handle : blob;
};
type RedeemAiAppPrivateMatchCapabilitySuccess = record {
  context : AppScopedCardContext;
  source_binding : blob;
  app_canister_id : principal;
  recipient_key_scheme : text;
  recipient_public_key : blob;
  expires_at : nat64;
};
type RedeemAiAppPrivateMatchCapabilityResponse = variant {
  Success : RedeemAiAppPrivateMatchCapabilitySuccess;
  NotFound;
  Expired;
  NotAuthorized;
  AppUnavailable;
  InvalidRequest : text;
};
type Args = record { key_id : blob };
type Args_1 = record { lookups : vec AiAppLookup };
type Args_10 = record { name : text };
type Args_11 = record {
  page_size : nat8;
  page_index : nat32;
  search_term : opt text;
};
type Args_12 = record {
  page_size : nat8;
  page_index : nat32;
  installation_location : opt BotInstallationLocation;
  search_term : opt text;
  exclude_installed : bool;
};
type Args_13 = record { updates_since : nat64 };
type Args_14 = record { page_size : nat8; page_index : nat32 };
type Args_15 = record { app_id : nat32 };
type Args_16 = record { bot_id : principal };
type Args_17 = record { manifest : AiAppManifest };
type Args_18 = record {
  id : nat32;
  url : text;
  expires : nat64;
  logo : text;
  name : text;
  canister_id : principal;
  max_awards : nat32;
  chit_reward : nat32;
  submitted_by : principal;
};
type Args_19 = record { app_id : nat32 };
type Args_2 = record { user_id : principal; achievement_id : nat32 };
type Args_20 = record { bot_id : principal };
type Args_21 = record {
  // Raw 64-byte P-256 ECDSA signature (r||s, as WebCrypto emits) over the canonical revoke
  // challenge — proof the caller holds the private key for `public_key`. See the endpoint comment.
  signature : blob;
  key_version : nat64;
  // The exact P-256 SPKI PEM currently registered for this tuple.
  public_key : text;
  app_id : nat32;
  // Exact tuple returned by the app-authenticated link claim.
  app_subject : blob;
  // Client clock (ms) at signing time; bound into the challenge to give a replay window.
  timestamp : nat64;
};
type Args_22 = record { max_results : nat8; search_term : text };
type Args_23 = record {
  "principal" : opt principal;
  endpoint : opt text;
  owner : opt principal;
  bot_id : principal;
  definition : opt BotDefinition;
  avatar : OptionUpdate;
};
type Args_24 = record { username : opt text; user_id : opt principal };
type Args_25 = record {
  user_groups : vec UserGroup;
  users_suspended_since : opt nat64;
};
type Args_26 = record { month : nat8; year : nat16; users : vec principal };
type Args_3 = record { updated_since : nat64 };
type Args_4 = record {
  // P-256 SPKI PEM key the exact registered app canister binds for this user.
  public_key : text;
  // The 256-bit lowercase-hex code shown to the OpenChat user.
  code : text;
};
type Args_5 = record { action_id : text; app_revision : nat64; app_id : nat32 };
type Args_6 = record {
  token : blob;
  recipient_public_key : blob;
  recipient_key_scheme : text;
};
type Args_7 = record {
  // Exactly 32 bytes, decoded from the canonical base64url launch fragment.
  token : blob;
  // The app account currently signed in. A mismatch never consumes the token.
  expected_app_subject : blob;
};
type Args_8 = record { username : text; is_bot : bool };
type Args_9 = record {
  // P-256 SPKI PEM public key to register for the code's (user, app) pair.
  public_key : text;
  // The 256-bit lowercase-hex claim token the user copied from OpenChat.
  code : text;
};
type AutonomousConfig = record { permissions : BotPermissions };
type BotCommandDefinition = record {
  permissions : BotPermissions;
  default_role : opt GroupRole;
  name : text;
  description : opt text;
  direct_messages : opt bool;
  placeholder : opt text;
  params : vec BotCommandParam;
};
type BotCommandOptionChoice = record { value : text; name : text };
type BotCommandOptionChoice_1 = record { value : int; name : text };
type BotCommandOptionChoice_2 = record { value : float64; name : text };
type BotCommandParam = record {
  name : text;
  description : opt text;
  required : bool;
  placeholder : opt text;
  param_type : BotCommandParamType;
};
type BotCommandParamType = variant {
  UserParam;
  StringParam : StringParam;
  DateTimeParam : DateTimeParam;
  IntegerParam : IntegerParam;
  DecimalParam : DecimalParam;
  BooleanParam;
};
type BotDataEncoding = variant { MsgPack; Json; Candid };
type BotDefinition = record {
  restricted_locations : opt vec BotInstallationLocationType;
  description : text;
  default_subscriptions : opt BotSubscriptions;
  autonomous_config : opt AutonomousConfig;
  commands : vec BotCommandDefinition;
  data_encoding : opt BotDataEncoding;
};
type BotDetails = record {
  id : principal;
  endpoint : text;
  owner : principal;
  restricted_locations : opt vec BotInstallationLocationType;
  name : text;
  description : text;
  last_updated : nat64;
  avatar_id : opt nat;
  autonomous_config : opt AutonomousConfig;
  commands : vec BotCommandDefinition;
