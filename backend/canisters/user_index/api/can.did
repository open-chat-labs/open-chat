  VisibilityChanged;
  RulesChanged;
  DescriptionChanged;
  MembersRemoved;
  InviteCodeChanged;
  GroupImported;
  BotRemoved;
  RoleChanged;
  BotAdded;
  Created;
  Frozen;
  AvatarChanged;
};
// A contextual value the client can provide to the model.
type ContextItem = variant {
  // Today's date, injected as "Today is <YYYY-MM-DD>."
  today;
};
// Declares contextual values the client injects into the prompt.
type ContextRule = record { provide : vec ContextItem };
type CurrentUserSummary = record {
  streak : nat16;
  max_streak : nat16;
  username : text;
  total_chit_earned : int32;
  profile_background_id : opt nat;
  is_platform_operator : bool;
  diamond_membership_status : DiamondMembershipStatusFull;
  is_unique_person : bool;
  hide_online_status : bool;
  user_id : principal;
  is_bot : bool;
  display_name : opt text;
  avatar_id : opt nat;
  moderation_flags_enabled : nat32;
  chit_balance : int32;
  is_suspected_bot : bool;
  suspension_details : opt SuspensionDetails;
  is_platform_moderator : bool;
  diamond_membership_details : opt DiamondMembershipDetails;
};
type DateTimeParam = record { future_only : bool };
type DecimalParam = record {
  max_value : float64;
  min_value : float64;
  choices : vec BotCommandOptionChoice_2;
};
type DiamondMembershipDetails = record {
  pay_in_chat : bool;
  subscription : DiamondMembershipSubscription;
  expires_at : nat64;
};
type DiamondMembershipFees = record {
  one_year : nat64;
  token_symbol : text;
  lifetime : nat64;
  one_month : nat64;
  three_months : nat64;
};
type DiamondMembershipStatus = variant { Inactive; Lifetime; Active };
type DiamondMembershipStatusFull = variant {
  Inactive;
  Lifetime;
  Active : DiamondMembershipDetails;
};
type DiamondMembershipSubscription = variant {
  OneYear;
  ThreeMonths;
  Disabled;
  OneMonth;
};
type ExternalAchievement = record {
  id : nat32;
  url : text;
  expires : nat64;
  name : text;
  budget_exhausted : bool;
  chit_reward : nat32;
};
// Fills one output field directly from the user's message text, bypassing the model.
type FromMessageRule = record {
  // Key in the model's JSON output this rule targets.
  field : text;
  // Maximum length the copied text is truncated to (defaults to 200 on the client).
  max_length : opt nat32;
};
type GroupRole = variant { Participant; Admin; Moderator; Owner };
// Free-form guidance appended verbatim to the prompt.
type InstructionRule = record { "text" : text };
type IntegerParam = record {
  max_value : int;
  min_value : int;
  choices : vec BotCommandOptionChoice_1;
};
// Maps keywords found in the user's message to a fixed value for one output field.
type KeywordMapRule = record {
  map : vec KeywordMapping;
  // Key in the model's JSON output this rule targets.
  field : text;
  mode : RuleMode;
};
// One value and the keywords whose presence in the message selects it.
type KeywordMapping = record { value : text; keywords : vec text };
// A single normalization operation applied to a field's value.
type NormalizeOp = variant {
  // Converts strings like "26k" / "1.5m" into numbers (x1e3 / x1e6).
  k_m_suffix;
  trim;
  lowercase;
  uppercase;
  // Strips currency symbols, commas and spaces, then parses a number when possible.
  strip_symbols;
};
// Applies deterministic normalization operations, in order, to one output field.
type NormalizeRule = record {
  ops : vec NormalizeOp;
  // Key in the model's JSON output this rule targets.
  field : text;
};
type OptionUpdate = variant { NoChange; SetToNone; SetToSome : text };
type ReferralMetrics = record {
  users_who_referred : nat32;
  users_who_referred_unpaid_diamond : nat32;
  referrals_of_unpaid_diamond : nat32;
  icp_raised_by_referrals_to_paid_diamond : nat32;
  referrals_of_paid_diamond : nat32;
  users_who_referred_paid_diamond : nat32;
  referrals_other : nat32;
  users_who_referred_90_percent_unpaid_diamond : nat32;
};
type Response = variant { NotInitialised; Success : SuccessResult };
type Response_1 = variant { NotStaged; InvalidKeyId; Success };
type Response_10 = variant {
  Error : record { nat16; opt text };
  UsernameTaken;
  UsernameTooShort : nat16;
  UsernameInvalid;
  UsernameTooLong : nat16;
  Success;
};
type Response_11 = variant { SuccessV2 : SuccessResult_8 };
type Response_12 = variant {
  CodeExpired;
  Error : record { nat16; opt text };
  InvalidRequest : text;
  CodeNotFound;
};
type Response_13 = variant {
  Error : record { nat16; opt text };
  Success : SuccessResult_9;
  UserNotFound;
};
type Response_14 = variant {
  Error : record { nat16; opt text };
  NotFound;
  Success;
};
type Response_15 = variant { Success : vec DiamondMembershipFees };
type Response_16 = variant {
  InvalidPageSize : nat8;
  Error : record { nat16; opt text };
  TermTooShort : nat8;
  ResponseTooLarge : nat32;
  Success : SuccessResult_10;
  TermTooLong : nat8;
};
type Response_17 = variant {
  Error : record { nat16; opt text };
  TermTooShort : nat8;
  Success : SuccessResult_11;
  TermTooLong : nat8;
  InvalidTerm;
};
type Response_18 = variant { Success : SuccessResult_12; SuccessNoUpdates };
type Response_19 = variant {
  InvalidPageSize : nat8;
  ResponseTooLarge : nat32;
  Success : SuccessResult_13;
  UserNotFound;
};
type Response_2 = variant { Success : SuccessResult_1 };
type Response_20 = variant { Success : SuccessResult_14 };
type Response_21 = variant { Success : principal };
type Response_22 = variant { Success : SuccessResult_15 };
type Response_23 = variant {
  Error : record { nat16; opt text };
  NotInitialised;
  Success : text;
};
type Response_24 = variant {
  Error : record { nat16; opt text };
  // The manifest declared no `app_canister_id`, or that canister did not vouch for the app's
  // name (returned false, trapped, or was unreachable). Publishing is blocked until an app
  // canister vouches — the anti-squatting gate.
  NotVerified;
  NotFound;
  NotAuthorised;
  Success;
};
type Response_25 = variant {
  Error : record { nat16; opt text };
  NotFound;
  NotAuthorised;
  Success;
};
type Response_26 = variant { Success : ReferralMetrics };
type Response_27 = variant {
  Error : record { nat16; opt text };
  Success : AiAppRegistration;
  InvalidRequest : text;
};
type Response_28 = variant {
  Error : record { nat16; opt text };
  NotAuthorised;
  Success;
  BotNotFound;
};
type Response_29 = variant {
  Error : record { nat16; opt text };
  Success;
  KeyNotFound;
};
type Response_3 = variant {
  ResponseTooLarge : nat32;
  Success : SuccessResult_1;
  TooManyApps : nat8;
};
type Response_30 = variant { Success : Result };
type Response_31 = variant { Error : text; Success : Args };
type Response_32 = variant {
  Error : record { nat16; opt text };
  TooManyCommands;
  DescriptionTooLong;
  EndpointInvalid;
  BotSuspended;
  NewOwnerSuspended;
  AvatarInvalid;
  NotAuthorised;
  PrincipalAlreadyUsed;
  Success;
  BotNotFound;
  NewOwnerNotFound;
  OwnerSuspended;
  OwnerNotFound;
  PrincipalInvalid;
};
type Response_33 = variant {
  Error : record { nat16; opt text };
  Success : UserSummary;
  UserNotFound;
};
type Response_34 = variant {
  Error : record { nat16; opt text };
  Success : principal;
  NewRegistrationsClosed;
};
type Response_35 = variant { Success : Result_1 };
type Response_36 = variant { Success : SuccessResult_16 };
type Response_4 = variant {
  InvalidCaller;
  Error : record { nat16; opt text };
  NotFound;
  Success : SuccessResult_2;
  AlreadyAwarded;
  InsufficientBudget;
  Expired;
};
type Response_5 = variant { Success : SuccessResult_3; SuccessNoUpdates };
type Response_6 = variant {
  CodeExpired;
  Error : record { nat16; opt text };
  NotAuthorized;
  Success : SuccessResult_4;
  InvalidRequest : text;
  CodeNotFound;
};
type Response_7 = variant {
  NotAuthorized;
  Success : SuccessResult_5;
  AppUnavailable;
  InvalidRequest : text;
};
type Response_8 = variant {
  NotFound;
  NotAuthorized;
  Success : SuccessResult_6;
  AppUnavailable;
  InvalidRequest : text;
  Expired;
};
type Response_9 = variant {
  Error : record { nat16; opt text };
  TokenNotFound;
  SubjectMismatch;
  NotAuthorized;
  Success : SuccessResult_7;
  TokenExpired;
  AppUnavailable;
  InvalidRequest : text;
};
type Result = record { timestamp : nat64; users : vec UserSummary };
type Result_1 = record {
  deleted : vec principal;
  timestamp : nat64;
  users : vec UserSummaryV2;
  current_user : opt CurrentUserSummary;
};
// Whether a rule merely guides the model (`Hint`) or deterministically overrides its output (`Override`).
type RuleMode = variant { hint; override };
type StringParam = record {
  min_length : nat16;
  multi_line : bool;
  max_length : nat16;
  choices : vec BotCommandOptionChoice;
};
type SuccessOnly = variant { Success };
type SuccessResult = record {
  keys : vec ActionSigningPublicKey;
  signature_version : nat16;
  purpose : text;
};
type SuccessResult_1 = record { apps : vec AiAppRegistration };
type SuccessResult_10 = record {
  total : nat32;
  matches : vec AiAppRegistration;
};
type SuccessResult_11 = record { total : nat32; matches : vec BotMatch };
type SuccessResult_12 = record {
  last_updated : nat64;
  added_or_updated : vec ExternalAchievement;
};
type SuccessResult_13 = record { total : nat32; apps : vec AiAppRegistration };
type SuccessResult_14 = record { users : vec principal };
type SuccessResult_15 = record { users : vec principal };
type SuccessResult_16 = record { chit : vec Chit };
type SuccessResult_2 = record { remaining_chit_budget : nat32 };
type SuccessResult_3 = record {
  timestamp : nat64;
  added_or_updated : vec BotDetails;
  removed : vec principal;
};
type SuccessResult_4 = record {
  // Monotonic epoch for this exact (user, app) key binding. Revoke proofs must bind it.
  key_version : nat64;
  subject_version : nat16;
  app_revision : nat64;
  app_id : nat32;
  // Stable only within this exact UserIndex/app/app-canister scope. The registered app receives
  // no global OpenChat user id and cannot join this value with another app's subject.
  app_subject : blob;
  // Opaque HMAC queue selector for this exact UserIndex/app/inbox/key binding. It is disclosed
  // only to the authenticated app canister and cannot be recomputed from the public PEM.
  consumer_queue_selector : blob;
  consumer_queue_selector_version : nat16;
  app_canister_id : principal;
};
type SuccessResult_5 = record {
  inbox_canister_id : principal;
  // Opaque HMAC selector for the current effective app/action consumer key.
  consumer_queue_selector : blob;
  consumer_queue_selector_version : nat16;
};
type SuccessResult_6 = record {
  context : AppScopedCardContext;
  recipient_public_key : blob;
  content_hash : blob;
  recipient_key_scheme : text;
  scope : AiAppCardCapabilityScope;
  app_canister_id : principal;
  expires_at : nat64;
};
type SuccessResult_7 = record {
  // Exact consent/key lifecycle epoch for this user/app binding.
  app_user_key_version : nat64;
  subject_version : nat16;
  app_revision : nat64;
  app_id : nat32;
  app_subject : blob;
  chat_handle_version : nat16;
  app_canister_id : principal;
  chat_handle : blob;
  // Presentation-only label captured when the user explicitly opened chat setup.
  chat_name : opt text;
};
type SuccessResult_8 = record {
  all_time : vec ChitUserBalance;
  last_month : vec ChitUserBalance;
  this_month : vec ChitUserBalance;
};
type SuccessResult_9 = record {
  streak : nat16;
  max_streak : nat16;
  username : text;
  total_chit_earned : int32;
  date_created : nat64;
  is_platform_operator : bool;
  diamond_membership_status : DiamondMembershipStatusFull;
  icp_account : blob;
  is_unique_person : bool;
  accepted_terms_version : nat32;
  referrals : vec principal;
  hide_online_status : bool;
  user_id : principal;
  display_name : opt text;
  avatar_id : opt nat;
  moderation_flags_enabled : nat32;
  chit_balance : int32;
  is_suspected_bot : bool;
  current_terms_version : nat32;
  suspension_details : opt SuspensionDetails;
  is_platform_moderator : bool;
  diamond_membership_details : opt DiamondMembershipDetails;
};
// How OpenChat presents a surface when it opens it.
type SurfaceDisplay = variant {
  // Embedded in-app (an iframe hosted in a bottom sheet).
  sheet;
  // Opened in the system browser / a new tab.
  external;
};
type SuspensionAction = variant { Unsuspend : nat64; Delete : nat64 };
type SuspensionDetails = record {
  action : SuspensionAction;
  suspended_by : principal;
  reason : text;
};
type UserGroup = record { users : vec principal; updated_since : nat64 };
type UserSummary = record {
  streak : nat16;
  max_streak : nat16;
  username : text;
  total_chit_earned : int32;
  diamond_member : bool;
  diamond_membership_status : DiamondMembershipStatus;
  is_unique_person : bool;
  hide_online_status : bool;
  user_id : principal;
  is_bot : bool;
  display_name : opt text;
  avatar_id : opt nat;
  chit_balance : int32;
  suspended : bool;
};
type UserSummaryStable = record {
  username : text;
  profile_background_id : opt nat;
  diamond_membership_status : DiamondMembershipStatus;
  is_unique_person : bool;
  hide_online_status : bool;
  is_bot : bool;
  display_name : opt text;
  avatar_id : opt nat;
  suspended : bool;
};
type UserSummaryV2 = record {
  stable : opt UserSummaryStable;
  user_id : principal;
  volatile : opt UserSummaryVolatile;
};
type UserSummaryVolatile = record {
  streak : nat16;
  max_streak : nat16;
  total_chit_earned : int32;
  chit_balance : int32;
};
