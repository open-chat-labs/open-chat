};
type BotPermissions = record {
  chat : nat32;
  community : nat32;
  message : nat32;
};
type BotRegistrationStatus = variant {
  Private : opt BotInstallationLocation;
  Public;
};
type BotSubscriptions = record {
  chat : vec ChatEventType;
  community : vec CommunityEventType;
};
