type CanisterId = principal;
type UserId = CanisterId;
type TimestampMillis = nat64;
type PuzzleNumber = nat32;
type GameId = text;

type OCError = record { nat16; opt text; };

type UnitResult = variant {
    Success;
    Error : OCError;
};

type DailyPuzzleConfig = record {
    enabled : bool;
    entry_fee : nat32;
    first_play_free : bool;
    reward_by_streak : vec nat32;
    hint_penalty : nat32;
    min_carded_solve_ms : nat64;
    max_submits : nat16;
    max_free_checks : nat16;
};

type PublicDailyPuzzle = record {
    game_id : GameId;
    number : PuzzleNumber;
    tier : nat8;
    description : blob;
    starts_at : TimestampMillis;
    expires_at : TimestampMillis;
    enabled : bool;
    entry_fee : nat32;
    first_play_free : bool;
    hint_prices : vec nat32;
    max_hints : nat8;
    max_free_checks : nat16;
    min_carded_solve_ms : nat64;
};

type DailyPuzzleResult = record {
    game_id : GameId;
    number : PuzzleNumber;
    user_id : UserId;
    solve_time_ms : nat64;
    hints_used : nat8;
    streak : nat32;
    solved_at : TimestampMillis;
};

type CandidateView = record {
    game_id : GameId;
    index : nat8;
    description : blob;
    tier : nat8;
    vetoed : bool;
    hint_count : nat32;
};

type CandidatesArgs = record {
    number : PuzzleNumber;
};

type CandidatesResponse = variant {
    Success : vec CandidateView;
    Error : OCError;
};

type ConfigResponse = variant {
    Success : DailyPuzzleConfig;
    Error : OCError;
};

type CurrentPuzzlesResponse = variant {
    Success : vec PublicDailyPuzzle;
    Error : OCError;
};

type RegenerateTodayArgs = record {
    game_id : opt GameId;
};

type ResultsArgs = record {
    game_id : GameId;
    number : PuzzleNumber;
    user_ids : vec UserId;
};

type ResultsResponse = variant {
    Success : vec DailyPuzzleResult;
    Error : OCError;
};

type SetEnabledArgs = record {
    enabled : bool;
};

type VetoCandidateArgs = record {
    number : PuzzleNumber;
    game_id : GameId;
    index : nat8;
};

service : {
    config : (record {}) -> (ConfigResponse) query;
    current_puzzles : (record {}) -> (CurrentPuzzlesResponse) query;
    results : (ResultsArgs) -> (ResultsResponse) query;

    candidates : (CandidatesArgs) -> (CandidatesResponse);
    push_now : (record {}) -> (UnitResult);
    regenerate_today : (RegenerateTodayArgs) -> (UnitResult);
    set_enabled : (SetEnabledArgs) -> (UnitResult);
    veto_candidate : (VetoCandidateArgs) -> (UnitResult);
};
