// This is a trimmed down version of the full candid file which can be found here -
// https://dashboard.internetcomputer.org/canister/ne2vj-6yaaa-aaaag-qb3ia-cai

type SwapArgs = record {
  amountIn: text;
  amountOutMinimum: text;
  zeroForOne: bool;
};
type NatResult = variant {
  err: Error;
  ok: nat;
};
type Error = variant {
  CommonError;
  InsufficientFunds;
  InternalError: text;
  UnsupportedToken: text;
};
type WithdrawArgs = record {
  amount: nat;
  fee: nat;
  token: text;
};
type UnusedBalanceResult = variant {
  err: Error;
  ok: record {
    balance0: nat;
    balance1: nat;
  };
};
type DepositAndSwapArgs = record {
  amountIn: text;
  amountOutMinimum: text;
  tokenInFee: nat;
  tokenOutFee: nat;
  zeroForOne: bool;
};
service : {
  depositFromAndSwap: (DepositAndSwapArgs) -> (NatResult);
  getUserUnusedBalance: (principal) -> (UnusedBalanceResult) query;
  quoteForAll: (SwapArgs) -> (NatResult) query;
  withdraw: (WithdrawArgs) -> (NatResult);
}
