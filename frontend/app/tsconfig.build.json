{
    // The program rollup's typescript plugin compiles (rollup.config.mjs). It only emits files in its
    // program and can't follow imports from .svelte files, so @openchat/ui's TypeScript, which the
    // new web UI's components import, is added here. Kept out of tsconfig.json so the app's type
    // check doesn't take on the library (it has its own tsconfig).
    "extends": "./tsconfig.json",
    "include": [
        "./src/**/*",
        "../vite-env.d.ts",
        "../global.d.ts",
        "../node_modules/component-lib/src/**/*.ts",
        "../openchat-ui/src/lib/**/*.ts",
        "../openchat-ui/src/features/**/*.ts"
    ],
    // the package barrels re-export types from .svelte files, which this program can't read
    "exclude": [
        "build/**/*",
        "node_modules",
        "../openchat-ui/src/**/*.spec.ts",
        "../openchat-ui/src/lib/index.ts",
        "../openchat-ui/src/features/index.ts"
    ]
}
