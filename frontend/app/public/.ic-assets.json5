[
    {
        match: "{*.svg,*.jpg,*.jpeg,*.png,*.gif,*.webp,*.mp3}",
        headers: {
            "Cache-Control": "public, max-age=2592000",
            "X-Cacheable-Resource": "true",
        },
    },
    {
        // The prize claim human check's page, which the website and the apps frame. Revalidated, so
        // that a release's change reaches everyone at once.
        match: "turnstile.{html,js}",
        headers: {
            "Cache-Control": "no-cache",
        },
    },
    {
        match: "openchat.webmanifest",
        headers: {
            "Content-Type": "application/manifest+json",
        }
    }
]
